# Python generated files
__pycache__/
*.pyc
.venv/

# Personal documents - never commit
output/*.pdf
scripts/output/*.pdf

# Planning docs - local only
docs/

# Node
node_modules/

# Development screenshots, not part of the project.
shots/

# The desktop app tally. Runtime state that belongs to whichever machine is
# serving the site, not to the project: committing it would ship a made up
# starting number.
interest.count
.count-*

# Anything naming the actual server: the domain, and whatever else a real
# deployment needs. The repository describes how to deploy, never where to.
.env
*.env
!*.env.example

# Keys, in case one is ever put here by accident.
*.pem
*.key
id_rsa*

# The security checklist. A working note to come back to before launch, not
# something to publish: it lists what was tested and what was not, which is
# more useful to somebody probing the site than to anyone reading the repo.
SECURITY-CHECKLIST.md

